{
  "uid": "task-api", "title": "Task Management API", "schemaVersion": 41,
  "version": 1, "refresh": "10s", "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "API reachable (1 = yes)", "type": "stat", "gridPos": {"x": 0,"y": 0,"w": 8,"h": 6}, "datasource": {"type": "prometheus","uid": "prometheus"}, "targets": [{"expr": "up{job=\"task-api\"}","refId": "A"}]},
    {"id": 2, "title": "Responses since API startup", "type": "stat", "gridPos": {"x": 8,"y": 0,"w": 8,"h": 6}, "datasource": {"type": "prometheus","uid": "prometheus"}, "targets": [{"expr": "sum(task_api_requests_total)","refId": "A"}]},
    {"id": 3, "title": "Requests per second", "type": "timeseries", "gridPos": {"x": 0,"y": 6,"w": 24,"h": 8}, "datasource": {"type": "prometheus","uid": "prometheus"}, "targets": [{"expr": "sum by (route) (rate(task_api_requests_total[1m]))","legendFormat": "{{route}}","refId": "A"}]}
  ]
}
